            "timeout": 900,
            "upgrade_install": null,
            "values": [
              "\"config\":\n  \"exporters\":\n    \"debug\":\n      \"verbosity\": \"basic\"\n    \"otlphttp\":\n      \"endpoint\": \"http://loki.monitoring.svc.cluster.local:3100/otlp\"\n      \"tls\":\n        \"insecure\": true\n    \"prometheus\":\n      \"endpoint\": \"0.0.0.0:8889\"\n  \"processors\":\n    \"batch\": {}\n    \"memory_limiter\":\n      \"check_interval\": \"5s\"\n      \"limit_percentage\": 80\n      \"spike_limit_percentage\": 25\n  \"receivers\":\n    \"otlp\":\n      \"protocols\":\n        \"grpc\":\n          \"endpoint\": \"0.0.0.0:4317\"\n        \"http\":\n          \"endpoint\": \"0.0.0.0:4318\"\n  \"service\":\n    \"pipelines\":\n      \"logs\":\n        \"exporters\":\n        - \"otlphttp\"\n        - \"debug\"\n        \"processors\":\n        - \"memory_limiter\"\n        - \"batch\"\n        \"receivers\":\n        - \"otlp\"\n      \"metrics\":\n        \"exporters\":\n        - \"prometheus\"\n        - \"debug\"\n        \"processors\":\n        - \"memory_limiter\"\n        - \"batch\"\n        \"receivers\":\n        - \"otlp\"\n\"fullnameOverride\": \"otel-collector\"\n\"image\":\n  \"repository\": \"otel/opentelemetry-collector-contrib\"\n\"mode\": \"deployment\"\n\"ports\":\n  \"metrics\":\n    \"containerPort\": 8889\n    \"enabled\": true\n    \"protocol\": \"TCP\"\n    \"servicePort\": 8889\n  \"otlp\":\n    \"containerPort\": 4317\n    \"enabled\": true\n    \"protocol\": \"TCP\"\n    \"servicePort\": 4317\n  \"otlp-http\":\n    \"containerPort\": 4318\n    \"enabled\": true\n    \"protocol\": \"TCP\"\n    \"servicePort\": 4318\n\"service\":\n  \"enabled\": true\n  \"type\": \"ClusterIP\"\n"
            ],
