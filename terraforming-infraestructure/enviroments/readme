# =========================
# Inicialização do Terraform
# =========================

terraform init

# =========================
# Validação da configuração
# =========================

terraform validate

# =========================
# ECR
# Repositórios Docker
# =========================

terraform plan -target="module.ecr"
terraform apply -target="module.ecr"

# =========================
# Credenciais AWS
# Verificar antes do EKS
# =========================

# lembrar de configurar:
# - cluster_role_arn
# - node_role_arn
# - AWS_ACCESS_KEY_ID
# - AWS_SECRET_ACCESS_KEY
# - AWS_SESSION_TOKEN

# =========================
# VPC
# Infraestrutura de rede
# =========================

terraform plan -target="module.vpc"
terraform apply -target="module.vpc"

# =========================
# EKS
# Cluster Kubernetes
# =========================

terraform plan -target="module.eks"
terraform apply -target="module.eks"

# =========================
# DynamoDB
# Banco NoSQL
# =========================

terraform plan -target="module.analytics_dynamodb"
terraform apply -target="module.analytics_dynamodb"

# =========================
# RDS
# Banco relacional
# =========================

terraform plan -target="module.rds"
terraform apply -target="module.rds"

# =========================
# SQS
# Filas de mensageria
# =========================

terraform plan -target="module.evaluation_response_sqs"
terraform apply -target="module.evaluation_response_sqs"

# =========================
# Cluster Manifests
# Recursos Kubernetes base
# =========================

terraform plan -target="module.cluster_manifests"
terraform apply -target="module.cluster_manifests"

# =========================
# Observability
# Prometheus, Grafana,
# Loki, Tempo e métricas
# =========================

terraform plan -target="module.observability"
terraform apply -target="module.observability"

# =========================
# Microservices Secrets
# Kubernetes Secrets
# =========================

terraform plan -target="module.microservices_secrets"
terraform apply -target="module.microservices_secrets"

# =========================
# ArgoCD
# Instalação do ArgoCD
# =========================

terraform plan -target="module.argocd"
terraform apply -target="module.argocd"

# =========================
# ArgoCD Applications
# Criação das aplicações GitOps
# =========================

terraform plan -target="module.argocd_applications"
terraform apply -target="module.argocd_applications"

# =========================
# Validação Final
# Aplicação completa
# =========================

terraform plan
terraform apply