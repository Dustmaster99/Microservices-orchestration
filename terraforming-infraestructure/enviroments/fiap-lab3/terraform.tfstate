      "module": "module.microservices_manifests",
      "mode": "managed",
      "type": "kubernetes_manifest",
      "name": "redis_deployment",
      "provider": "provider[\"registry.terraform.io/hashicorp/kubernetes\"]",
      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "computed_fields": null,
            "field_manager": [],
            "manifest": {
              "value": {
                "apiVersion": "apps/v1",
                "kind": "Deployment",
                "metadata": {
                  "name": "redis-deployment",
                  "namespace": "fiap-microservices"
                },
                "spec": {
                  "replicas": 1,
                  "selector": {
                    "matchLabels": {
                      "app": "redis-server"
                    }
                  },
                  "template": {
                    "metadata": {
                      "labels": {
                        "app": "redis-server"
                      }
                    },
                    "spec": {
                      "containers": [
                        {
                          "command": [
                            "redis-server",
                            "--bind",
                            "0.0.0.0"
                          ],
                          "env": [
                            {
                              "name": "REDIS_PORT",
                              "value": "6379"
                            }
                          ],
                          "image": "760729969288.dkr.ecr.us-east-1.amazonaws.com/fiap-microservices/redis:latest",
                          "name": "redis-server",
                          "ports": [
                            {
                              "containerPort": 6379
                            }
                          ]
                        }
                      ],
                      "restartPolicy": "Always"
                    }
                  }
                }
              },
              "type": [
